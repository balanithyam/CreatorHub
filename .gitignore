# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Environment variables & secrets (CRITICAL: Never commit API keys or JWT secrets)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.env.local

# Production builds
dist/
*/dist/
build/
*/build/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Microsoft Office temporary lock files
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads & temporary media (preserve folder structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary test files
test*.txt
test_*.txt

# IDE & Editor folders
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
